SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
TEST_PASSWORD=test1234

# GEMINI_API_KEY / GEMINI_MODEL はここに書かない。この .env は pubspec.yaml の
# assets に登録されており Flutter アプリ(web含む)に同梱されるため、Gemini の
# キーをここに書くと配布物からキーが読める状態になってしまう。
#
# AI講評(supabase/functions/ai-review)と周辺アクティビティ提案
# (supabase/functions/activity-suggest)がGemini APIを呼ぶために使うキーは、
# Google AI Studio (https://aistudio.google.com/apikey) で取得し、
#   npx supabase secrets set GEMINI_API_KEY=<取得したキー>
#   npx supabase secrets set GEMINI_MODEL=<使うモデル名>  # 省略時は gemini-3.6-flash
# gemini-3.8-flash は使わないこと(実測でこのプロジェクトのキーでは応答が返らない)。
# でセットする(Edge Function側のsecretとしてのみ持つ)。ローカルで
# `npx supabase functions serve <function名>` する場合は、代わりに
# supabase/functions/.env に同じ内容を書く(gitignore済み)。
