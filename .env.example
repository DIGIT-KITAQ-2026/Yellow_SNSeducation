SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
TEST_PASSWORD=test1234

# AI講評(supabase/functions/ai-review)がGemini APIを呼ぶために使うキー。
# Flutterアプリはこのキーを直接使わない(Edge Function側のsecretとして設定する)。
# Google AI Studio (https://aistudio.google.com/apikey) で取得したキーを、
#   npx supabase secrets set GEMINI_API_KEY=<取得したキー>
# でセットする。ローカルで `npx supabase functions serve ai-review` する場合は、
# 代わりに supabase/functions/.env に同じ内容を書く(gitignore済み)。
GEMINI_API_KEY=<Google AI StudioのAPIキー>
# 省略時は gemini-3.8-flash が使われる。
GEMINI_MODEL=gemini-3.8-flash
